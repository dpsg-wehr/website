{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "minimumReleaseAge": "3 days",
    "rangeStrategy": "pin",
    "baseBranches": ["dev"],
    "labels": ["dependencies", "automated"],
    "github-actions": {
        "managerFilePatterns": ["/(^|/)\\.forgejo/workflows/.+\\.ya?ml$/"]
    },
    "vulnerabilityAlerts": {
        "labels": ["security", "dependencies"],
        "schedule": ["at any time"],
        "minimumReleaseAge": "0"
    },
    "packageRules": [
        {
            "description": "Group non-critical dev and minor/patch updates into a single weekly PR on Mondays",
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "matchDepTypes": ["devDependencies"],
            "groupName": "Weekly non-critical dependencies",
            "schedule": ["before 6:00am on Monday"],
            "automerge": false
        },
        {
            "description": "Separate PRs immediately for high-impact core packages",
            "matchPackageNames": [
                "next",
                "react",
                "react-dom",
                "tailwindcss",
                "@tailwindcss/*",
                "sharp"
            ],
            "schedule": ["at any time"]
        },
        {
            "description": "Group Playwright npm package and Docker image together",
            "matchPackageNames": ["@playwright/test", "playwright", "mcr.microsoft.com/playwright"],
            "groupName": "Playwright",
            "schedule": ["at any time"]
        },
        {
            "description": "Vite+ bundles Vitest: update vite-plus and the Vitest pins together (see catalog in pnpm-workspace.yaml)",
            "matchPackageNames": ["vite-plus", "vitest", "@vitest/*"],
            "groupName": "Vite+ toolchain",
            "schedule": ["at any time"]
        },
        {
            "description": "Prevent breaking major updates on pnpm-workspace.yaml overrides (e.g. js-yaml v3 for gray-matter, brace-expansion v1 for minimatch)",
            "matchDepTypes": ["pnpm-workspace.overrides"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        }
    ]
}
