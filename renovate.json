{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "minimumReleaseAge": "3 days",
    "baseBranches": ["dev"],
    "labels": ["dependencies", "automated"],
    "vulnerabilityAlerts": {
        "labels": ["security", "dependencies"],
        "schedule": ["at any time"],
        "minimumReleaseAge": "0"
    },
    "packageRules": [
        {
            "description": "Group non-critical dev and minor/patch updates into a single weekly PR on Mondays",
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "matchDepTypes": ["devDependencies"],
            "groupName": "Weekly non-critical dependencies",
            "schedule": ["before 6:00am on Monday"],
            "automerge": false
        },
        {
            "description": "Separate PRs immediately for high-impact core packages",
            "matchPackageNames": [
                "next",
                "react",
                "react-dom",
                "tailwindcss",
                "@tailwindcss/*",
                "sharp"
            ],
            "schedule": ["at any time"]
        }
    ]
}
