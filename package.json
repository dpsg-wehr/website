{
    "name": "website-dpsg-wehr",
    "version": "1.19.0",
    "private": true,
    "scripts": {
        "dev": "tsx scripts/generate-ics.ts && tsx scripts/generate-search-index.ts && astro dev --ignore-lock",
        "cms:proxy": "decap-server",
        "build": "tsx scripts/generate-ics.ts && tsx scripts/generate-search-index.ts && astro build",
        "preview": "astro preview",
        "start": "pnpm serve",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "lint": "vp lint && eslint .",
        "typecheck": "astro check && vp check --no-fmt --no-lint",
        "export": "pnpm run build",
        "serve": "npx serve@latest out",
        "test": "vp test",
        "test:watch": "vp test watch",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "pnpm test && pnpm test:e2e",
        "test:report": "npx serve test-results",
        "audit:lighthouse": "tsx scripts/run-lighthouse.ts",
        "prepare": "vp config --no-agent"
    },
    "dependencies": {
        "@astrojs/mdx": "8.1.3",
        "@astrojs/react": "7.1.5",
        "@astrojs/rss": "4.0.19",
        "@astrojs/sitemap": "3.7.4",
        "@fullcalendar/core": "7.1.4",
        "@fullcalendar/react": "7.1.4",
        "astro": "7.4.8",
        "fuse.js": "7.5.0",
        "gray-matter": "4.0.3",
        "ics": "3.12.1",
        "image-size": "2.1.0",
        "markdown-it": "15.0.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-icons": "5.7.0",
        "react-photo-album": "3.6.2",
        "react-select": "5.10.2",
        "sanitize-html": "2.18.1",
        "sharp": "0.35.5",
        "temporal-polyfill": "1.0.8",
        "yet-another-react-lightbox": "3.33.0"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@astrojs/compiler-rs": "0.5.3",
        "@axe-core/playwright": "4.14.0",
        "@lhci/cli": "0.16.1",
        "@playwright/test": "1.65.1",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.10",
        "@types/markdown-it": "14.2.0",
        "@types/mdx": "2.0.14",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/sanitize-html": "2.16.2",
        "@typescript-eslint/parser": "8.72.2",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "decap-server": "3.11.6",
        "eslint": "9.39.5",
        "eslint-plugin-astro": "3.2.1",
        "jsdom": "31.0.1",
        "monocart-reporter": "2.15.1",
        "tailwindcss": "4.3.5",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "vite": "8.3.8",
        "vite-plus": "catalog:",
        "vitest": "catalog:"
    },
    "browserslist": [
        "defaults and supports es6-module",
        "maintained node versions"
    ],
    "packageManager": "pnpm@12.18.0"
}
