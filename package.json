{
    "name": "website-dpsg-wehr",
    "version": "1.19.0",
    "packageManager": "pnpm@12.4.2",
    "private": true,
    "browserslist": [
        "defaults and supports es6-module",
        "maintained node versions"
    ],
    "scripts": {
        "dev": "next dev",
        "cms:proxy": "decap-server",
        "build": "tsx scripts/generate-ics.ts && tsx scripts/generate-search-index.ts && next build",
        "start": "pnpm serve",
        "lint": "eslint .",
        "export": "pnpm run build && next-image-export-optimizer && node scripts/inline-css.mjs",
        "release:dry-run": "semantic-release --dry-run --no-ci --branches $(git branch --show-current) --plugins @semantic-release/commit-analyzer",
        "serve": "npx serve@latest out",
        "test": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "pnpm test --run && pnpm test:e2e",
        "test:report": "npx serve test-results",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,css,md,mdx,json}": "prettier --write",
        "*.{js,jsx,ts,tsx}": "eslint --fix --no-warn-ignored"
    },
    "dependencies": {
        "@fullcalendar/core": "^7.0.0",
        "@fullcalendar/react": "^7.0.0",
        "fuse.js": "^7.5.0",
        "gray-matter": "^4.0.3",
        "ics": "^3.12.0",
        "image-size": "^2.0.2",
        "next": "^16.3.3",
        "next-image-export-optimizer": "^1.20.1",
        "next-mdx-remote": "^6.0.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "react-photo-album": "^3.6.1",
        "react-select": "^5.10.2",
        "rehype-img-size": "^1.0.1",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.35.4",
        "temporal-polyfill": "^1.0.4",
        "yet-another-react-lightbox": "^3.32.2"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "^16.3.3",
        "@playwright/test": "^1.62.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "decap-server": "^3.10.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.3.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jsdom": "30.0.1",
        "lint-staged": "^17.4.1",
        "monocart-reporter": "^2.12.6",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "semantic-release": "^25.0.9",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
