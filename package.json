{
    "name": "website-dpsg-wehr",
    "version": "1.19.0",
    "packageManager": "pnpm@12.16.1",
    "private": true,
    "browserslist": [
        "defaults and supports es6-module",
        "maintained node versions"
    ],
    "scripts": {
        "dev": "tsx scripts/generate-ics.ts && tsx scripts/generate-search-index.ts && astro dev --ignore-lock",
        "cms:proxy": "decap-server",
        "build": "tsx scripts/generate-ics.ts && tsx scripts/generate-search-index.ts && astro build",
        "preview": "astro preview",
        "start": "pnpm serve",
        "lint": "eslint .",
        "export": "pnpm run build",
        "serve": "npx serve@latest out",
        "test": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "pnpm test --run && pnpm test:e2e",
        "test:report": "npx serve test-results",
        "audit:lighthouse": "tsx scripts/run-lighthouse.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "astro check && tsc --noEmit",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,css,md,mdx,json}": "prettier --write",
        "*.{js,jsx,ts,tsx}": "eslint --fix --no-warn-ignored"
    },
    "dependencies": {
        "@astrojs/mdx": "8.1.2",
        "@astrojs/react": "7.1.2",
        "@astrojs/rss": "4.0.19",
        "@astrojs/sitemap": "3.7.4",
        "@fullcalendar/core": "7.1.1",
        "@fullcalendar/react": "7.1.1",
        "astro": "7.4.4",
        "fuse.js": "7.5.0",
        "gray-matter": "4.0.3",
        "ics": "3.12.1",
        "image-size": "2.0.4",
        "markdown-it": "15.0.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-icons": "5.7.0",
        "react-photo-album": "3.6.2",
        "react-select": "5.10.2",
        "sanitize-html": "2.18.1",
        "sharp": "0.35.5",
        "temporal-polyfill": "1.0.6",
        "yet-another-react-lightbox": "3.32.2"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@axe-core/playwright": "4.14.0",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "9.39.5",
        "@lhci/cli": "0.15.1",
        "@playwright/test": "1.64.1",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/markdown-it": "14.2.0",
        "@types/mdx": "2.0.14",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/sanitize-html": "2.16.2",
        "@typescript-eslint/eslint-plugin": "8.72.1",
        "@typescript-eslint/parser": "8.72.1",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "decap-server": "3.11.6",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-astro": "3.2.1",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "husky": "9.1.7",
        "jsdom": "30.1.3",
        "lint-staged": "17.6.0",
        "monocart-reporter": "2.15.1",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
