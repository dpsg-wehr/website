# Static serving with Nginx
# Expects pre-built artifacts in the 'out' directory
FROM nginx:alpine

ARG VERSION=1.19.0
ARG VCS_REF
ARG BUILD_DATE

LABEL org.opencontainers.image.title="website-dpsg-wehr" \
      org.opencontainers.image.description="Website of DPSG Stamm St. Bernhard Wehr" \
      org.opencontainers.image.url="https://dpsg-wehr.de" \
      org.opencontainers.image.source="https://git.linus-fischer.de/linus/website-dpsg-wehr" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="DPSG Stamm St. Bernhard Wehr"

# Install curl for healthcheck
RUN apk add --no-cache curl

# Security headers module might be needed if not built-in, but standard config works for basic setup.
# Alpine Nginx usually includes standard modules.

# Copy custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static output from build context
COPY out /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
