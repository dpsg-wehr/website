{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "verbatimModuleSyntax": false,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": {
            "@/*": ["./src/*", "./*"]
        },
        "types": ["@testing-library/jest-dom/vitest"]
    },
    "include": [
        ".astro/types.d.ts",
        "vitest-setup.ts",
        "src/**/*.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.astro",
        "components/**/*.ts",
        "components/**/*.tsx",
        "lib/**/*.ts",
        "lib/**/*.tsx",
        "scripts/**/*.ts",
        "types/**/*.ts",
        "e2e/**/*.ts"
    ],
    "exclude": ["node_modules", "out", "dist"]
}
