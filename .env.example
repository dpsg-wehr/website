# Dev / Test Deployment Configuration
# Subdomain for the dev preview deployment
DEV_DOMAIN=dev.dpsg-wehr.de

# Authentik forward-auth middleware name configured in Traefik (e.g. authentik@docker or authentik@file)
AUTHENTIK_MIDDLEWARE=authentik@docker

# Umami Analytics Configuration (Self-Hosted on VPS)
# Website ID (UUID) from your Umami dashboard at https://analytics.dpsg-wehr.de
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_HOST_URL=https://analytics.dpsg-wehr.de
# Domains to track (comma-separated, prevents tracking on localhost or test previews)
PUBLIC_UMAMI_DOMAINS=dpsg-wehr.de,www.dpsg-wehr.de
