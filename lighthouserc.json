{
    "ci": {
        "collect": {
            "staticDistDir": "./out",
            "url": [
                "http://localhost/index.html",
                "http://localhost/news/index.html",
                "http://localhost/gallerie/index.html",
                "http://localhost/pages/termine/index.html"
            ],
            "numberOfRuns": 2,
            "settings": {
                "chromeFlags": "--no-sandbox --disable-dev-shm-usage --disable-gpu --disable-software-rasterizer"
            }
        },
        "assert": {
            "assertions": {
                "categories:seo": ["error", { "minScore": 0.9 }],
                "categories:best-practices": ["error", { "minScore": 0.9 }],
                "categories:accessibility": ["warn", { "minScore": 0.9 }],
                "categories:performance": ["warn", { "minScore": 0.8 }]
            }
        },
        "upload": {
            "target": "lhci"
        }
    }
}
