---
import RootLayout from '@/layouts/RootLayout.astro';

interface InternalService {
    name: string;
    url: string;
    displayUrl: string;
    description: string;
    icon: string;
}

const services: InternalService[] = [
    {
        name: 'OpenCloud',
        url: 'https://cloud.dpsg-wehr.de',
        displayUrl: 'cloud.dpsg-wehr.de',
        description: 'Pfadicloud',
        icon: '/icons/opencloud.svg',
    },
    {
        name: 'Campflow',
        url: 'https://my.campflow.de/dpsg-wehr',
        displayUrl: 'my.campflow.de/dpsg-wehr',
        description: 'Lager- und Veranstaltungsanmeldungen, Mitgliederverwaltung etc.',
        icon: '/icons/campflow.svg',
    },
    {
        name: 'Sveltia CMS',
        url: 'https://dev.dpsg-wehr.de/admin/',
        displayUrl: 'dev.dpsg-wehr.de/admin/',
        description: 'Verwaltung der Website',
        icon: '/icons/sveltia.svg',
    },
    {
        name: 'Jitsi Meet',
        url: 'https://meet.fischernet.eu',
        displayUrl: 'meet.fischernet.eu',
        description: 'Videokonferenzen',
        icon: '/icons/jitsi.svg',
    },
];
---

<RootLayout
    title="Interne Links"
    description="Zentrale Übersicht über geschützte interne Dienste der DPSG Wehr."
    robots="noindex, nofollow"
>
    <div class="mx-auto max-w-3xl py-6 sm:py-10">
        <!-- Header -->
        <div class="mb-8">
            <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-100 px-3 py-1 text-xs font-semibold tracking-wider text-blue-800 uppercase dark:border-blue-900/50 dark:bg-blue-950/60 dark:text-blue-300">
                <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Intern
            </div>
            <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
                Interne Links
            </h1>
        </div>

        <!-- Directory List -->
        <div class="space-y-3.5">
            {services.map((service) => (
                <div class="group relative flex flex-col justify-between gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-xs transition-all duration-150 hover:border-gray-300 hover:shadow-sm sm:flex-row sm:items-center sm:p-5 dark:border-gray-700/80 dark:bg-gray-800 dark:hover:border-gray-600">
                    <div class="flex min-w-0 items-start gap-3.5 sm:items-center">
                        {/* Service Icon */}
                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 p-2 transition-transform duration-150 group-hover:scale-105 dark:border-gray-700 dark:bg-gray-700/50">
                            <img
                                src={service.icon}
                                alt={`${service.name} Icon`}
                                class="h-7 w-7 object-contain"
                                loading="lazy"
                            />
                        </div>

                        {/* Content info */}
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <h2 class="text-base font-semibold text-gray-900 dark:text-white">
                                    {service.name}
                                </h2>
                                <span class="hidden font-mono text-xs text-gray-500 sm:inline-block dark:text-gray-400">
                                    ({service.displayUrl})
                                </span>
                            </div>
                            <p class="mt-0.5 line-clamp-2 text-xs text-gray-600 sm:text-sm dark:text-gray-300">
                                {service.description}
                            </p>
                            <span class="mt-1 inline-block font-mono text-xs text-gray-500 sm:hidden dark:text-gray-400">
                                {service.displayUrl}
                            </span>
                        </div>
                    </div>

                    {/* Right action: open button */}
                    <div class="flex shrink-0 items-center justify-end border-t border-gray-100 pt-2 sm:border-t-0 sm:pt-0 dark:border-gray-700/60">
                        <a
                            href={service.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${service.name} öffnen`}
                            class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-1.5 text-sm font-medium text-white shadow-xs transition-colors hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:outline-hidden"
                        >
                            <span>Öffnen</span>
                            <svg
                                class="h-3.5 w-3.5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                <polyline points="15 3 21 3 21 9" />
                                <line x1="10" y1="14" x2="21" y2="3" />
                            </svg>
                        </a>
                    </div>
                </div>
            ))}
        </div>

        <!-- Help / Support Footer Note -->
        <div class="mt-8 border-t border-gray-200 pt-6 text-center text-xs text-gray-500 sm:text-left dark:border-gray-700/60 dark:text-gray-400">
            Du hast keinen Zugriff oder benötigst einen Account? Wende dich an Linus :)
        </div>
    </div>
</RootLayout>
