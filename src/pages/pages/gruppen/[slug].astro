---
import RootLayout from '@/layouts/RootLayout.astro';
import { getCollection, render } from 'astro:content';
import { mdxComponents } from '@/mdx-components';
import { getExcerpt } from '@/lib/utils/metadata';
import CmsEditButton from '@/components/ui/CmsEditButton.astro';

export async function getStaticPaths() {
    const gruppen = await getCollection('gruppen');
    return gruppen.map((entry) => ({
        params: { slug: entry.id.replace(/\.mdx$/, '') },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.description || entry.data.desc || getExcerpt(entry.body || '');
const title = entry.data.title || entry.id.replace(/\.mdx$/, '');
const entryId = entry.id.replace(/\.mdx$/, '');
const slug = entry.id.replace(/\.mdx$/, '');

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://dpsg-wehr.de';
const canonicalPageUrl = new URL(`/pages/gruppen/${slug}`, siteUrl).href;

const breadcrumbJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Startseite',
            item: `${siteUrl}/`,
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: 'Gruppen',
            item: `${siteUrl}/#gruppen`,
        },
        {
            '@type': 'ListItem',
            position: 3,
            name: title,
            item: canonicalPageUrl,
        },
    ],
};
---

<RootLayout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <article class="prose sm:prose-lg dark:prose-invert max-w-none">
        <Content components={mdxComponents} />
    </article>
    <div class="mt-8 pt-4 border-t border-gray-200 dark:border-gray-700 flex justify-end">
        <CmsEditButton
            collection="gruppen"
            entryId={entryId}
            label="Gruppenseite im CMS bearbeiten"
        />
    </div>
</RootLayout>
