---
import RootLayout from '@/layouts/RootLayout.astro';
import { getCollection, render } from 'astro:content';
import { mdxComponents } from '@/mdx-components';
import { getExcerpt } from '@/lib/utils/metadata';
import CmsEditButton from '@/components/ui/CmsEditButton.astro';

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    const excluded = ['startseite', 'gallerie'];
    return pages
        .filter((page) => !excluded.includes(page.id.replace(/\.mdx$/, '')))
        .map((page) => ({
            params: { slug: page.id.replace(/\.mdx$/, '') },
            props: { page },
        }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const description = page.data.description || page.data.desc || getExcerpt(page.body || '');
const title = page.data.title || page.id.replace(/\.mdx$/, '');
const entryId = page.id.replace(/\.mdx$/, '');
const slug = page.id.replace(/\.mdx$/, '');

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://dpsg-wehr.de';
const canonicalPageUrl = new URL(`/pages/${slug}`, siteUrl).href;

const breadcrumbJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Startseite',
            item: `${siteUrl}/`,
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: title,
            item: canonicalPageUrl,
        },
    ],
};
---

<RootLayout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <article class="prose sm:prose-lg dark:prose-invert max-w-none">
        <Content components={mdxComponents} />
    </article>
    <div class="mt-8 pt-4 border-t border-gray-200 dark:border-gray-700 flex justify-end">
        <CmsEditButton
            collection="pages"
            entryId={entryId}
            label="Seite im CMS bearbeiten"
        />
    </div>
</RootLayout>
