---
import CampflowForm from './CampflowForm.astro';

interface Props {
    src?: string;
    'data-slug'?: string;
    slug?: string;
    [key: string]: any;
}

const props = Astro.props;
const src = props.src || '';
const slug = props['data-slug'] || props.slug;
const isCampflow = src.includes('campflow.de') || Boolean(slug && src.includes('campflow'));
---

{isCampflow ? <CampflowForm {...props} slug={slug} /> : <script {...props} />}
