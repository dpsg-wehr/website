<div id="calendar-root">
    <div class="flex h-[670px] w-full animate-pulse items-center justify-center rounded-lg bg-gray-100 text-gray-500 dark:bg-gray-800">
        Kalender wird geladen...
    </div>
</div>

<script>
    const initCalendar = async () => {
        const el = document.getElementById('calendar-root');
        if (!el || el.dataset.hydrated) return;
        el.dataset.hydrated = 'true';

        try {
            const [React, { createRoot }, { default: Calendar }] = await Promise.all([
                import('react'),
                import('react-dom/client'),
                import('@/components/mdx/Calendar'),
            ]);

            const root = createRoot(el);
            root.render(React.createElement(Calendar));
        } catch {
            // Silently handle hydration failure
        }
    };

    const scheduleInit = () => {
        if ('requestIdleCallback' in window) {
            requestIdleCallback(() => initCalendar(), { timeout: 2000 });
        } else {
            setTimeout(initCalendar, 200);
        }
    };

    const el = document.getElementById('calendar-root');
    if (el) {
        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    if (entries[0]?.isIntersecting) {
                        observer.disconnect();
                        scheduleInit();
                    }
                },
                { rootMargin: '200px' }
            );
            observer.observe(el);
        } else {
            scheduleInit();
        }
    }
</script>
