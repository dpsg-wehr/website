---
import { Image } from 'astro:assets';
import { resolveImage } from '@/lib/assets/images';
import type { PostMetadata } from '@/types';

interface Props extends PostMetadata {
    priority?: boolean;
}

const props = Astro.props;
const imageMeta = resolveImage(props.image?.src);
---

<article
    class="mt-4 border shadow-sm hover:shadow-lg rounded-md dark:border-gray-600 w-full max-w-md"
>
    <a
        href={`/posts/${props.slug}`}
        class="flex flex-col h-full w-full no-underline"
    >
        <div class="relative aspect-video w-full overflow-hidden rounded-t-md bg-gray-200 dark:bg-gray-800">
            {imageMeta ? (
                <>
                    <Image
                        src={imageMeta}
                        alt=""
                        width={600}
                        class="absolute inset-0 w-full h-full object-cover blur-md opacity-50 scale-105 text-transparent"
                        loading={props.priority ? 'eager' : 'lazy'}
                        aria-hidden="true"
                    />
                    <Image
                        src={imageMeta}
                        alt={props.title}
                        width={600}
                        class="absolute inset-0 w-full h-full object-contain z-10 text-transparent"
                        loading={props.priority ? 'eager' : 'lazy'}
                    />
                </>
            ) : props.image?.src ? (
                <>
                    <img
                        src={props.image.src}
                        alt=""
                        class="absolute inset-0 w-full h-full object-cover blur-md opacity-50 scale-105 text-transparent"
                        loading={props.priority ? 'eager' : 'lazy'}
                        data-image-component="true"
                        aria-hidden="true"
                    />
                    <img
                        src={props.image.src}
                        alt={props.title}
                        class="absolute inset-0 w-full h-full object-contain z-10 text-transparent"
                        loading={props.priority ? 'eager' : 'lazy'}
                        data-image-component="true"
                    />
                </>
            ) : (
                <div class="w-full h-full bg-gray-100 dark:bg-gray-600" />
            )}
        </div>
        <div class="pt-3 ml-4 mr-2 mb-3 flex-1 flex flex-col">
            <h2 class="text-xl text-gray-900 dark:text-white">{props.title}</h2>
            <p class="text-gray-600 dark:text-gray-300 text-sm mt-1 flex-1">
                {props.desc}
            </p>
            <p class="text-gray-600 dark:text-gray-200 text-xs self-end mt-2">
                {props.date}
            </p>
        </div>
    </a>
</article>
