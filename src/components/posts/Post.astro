---
import CmsEditButton from '@/components/ui/CmsEditButton.astro';
import { formatPostDate } from '@/lib/utils/date';
import type { PostMetadata } from '@/types';

import FloatingImage from './FloatingImage.astro';

interface Props {
    postMetadata?: PostMetadata[];
    slug?: string;
    overrideMetadata?: Partial<PostMetadata>;
    metadata?: PostMetadata;
    collection?: string;
    entryId?: string;
}

const {
    postMetadata,
    slug,
    overrideMetadata,
    metadata: directMetadata,
    collection,
    entryId,
} = Astro.props;

const foundMetadata = directMetadata || postMetadata?.find((post) => post.slug === slug);
const metadata = overrideMetadata
    ? ({ ...foundMetadata, ...overrideMetadata } as PostMetadata)
    : foundMetadata;
---

{!metadata ? (
    <div>
        <article class="prose sm:prose-lg dark:prose-invert max-w-none">
            <slot />
        </article>
        {collection && entryId && (
            <div class="mt-8 flex justify-end border-t border-gray-200 pt-4 dark:border-gray-700">
                <CmsEditButton
                    collection={collection}
                    entryId={entryId}
                    label="Beitrag im CMS bearbeiten"
                />
            </div>
        )}
    </div>
) : (
    <div>
        {metadata.image?.src && (
            <FloatingImage
                src={metadata.image.src}
                alt={metadata.title ?? ''}
                width={metadata.image.width ?? 0}
                height={metadata.image.height ?? 0}
            />
        )}
        <div class="mb-8">
            <h1 class="text-center text-4xl font-bold">{metadata.title}</h1>
            <h2 class="text-center text-xl font-light">{metadata.subtitle}</h2>
        </div>
        <p class="text-center font-light text-gray-800 dark:text-gray-200">
            {metadata.date && formatPostDate(metadata.date)}
        </p>
        <hr class="mt-3 mb-12" />
        <article class="prose sm:prose-lg dark:prose-invert max-w-none">
            <slot />
        </article>
        {collection && entryId && (
            <div class="mt-8 flex justify-end border-t border-gray-200 pt-4 dark:border-gray-700">
                <CmsEditButton
                    collection={collection}
                    entryId={entryId}
                    label="Beitrag im CMS bearbeiten"
                />
            </div>
        )}
    </div>
)}
